# ─────────────────────────────────────────────────────────────────────────────
# KALP chatbot — production environment template (Hostinger VPS)
#
# Copy this file to the server as `~/.env` and fill in the real values:
#     cp deploy/kalp.env.example /home/chatbot/chatbot/.env
#
# Provider setup used here:
#   - Answering model : OpenRouter  (meta-llama/llama-3.3-70b-instruct)
#   - Embeddings      : HuggingFace (sentence-transformers/all-MiniLM-L6-v2)
#   - No Ollama needed on the VPS.
#
# NOTE: the env var names below still say "GROQ_" for backward-compatibility
# with the code. The LLM client uses the standard OpenAI-compatible format
# (POST /chat/completions + Bearer auth + SSE streaming), which OpenRouter,
# Groq and most providers all speak — so just point GROQ_BASE_URL / GROQ_API_KEY
# / GROQ_MODEL at your chosen provider.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (local SQLite + ChromaDB are fine for a single VPS) ─────────────
DATABASE_URL=sqlite:///./app.db
CHROMA_PATH=./vector_db

# ── Admin login (CHANGE to strong random values before deploying) ────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
SESSION_SECRET=replace-with-long-random-string
CSRF_SECRET=replace-with-a-different-long-random-string

# ── CORS — must include your shop + widget subdomain ─────────────────────────
CORS_ORIGINS=["https://kalp-shop.in","https://chat.kalp-shop.in"]

# ── Answering model: OpenRouter ──────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys  (add a small credit balance)
GROQ_API_KEY=sk-or-v1-your-openrouter-key
GROQ_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_BASE_URL=https://openrouter.ai/api/v1

# ── Embeddings: HuggingFace (cloud, free for this model) ─────────────────────
# Get a read token at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your-huggingface-token
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_OLLAMA_EMBEDDINGS=false

# ── RAG / ingestion tuning ───────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DEFAULT_TOP_K=10

# ── Crawler limits (tune if you crawl kalp-shop.in) ──────────────────────────
CRAWLER_MAX_PAGES=50
CRAWLER_TIMEOUT=10
ALLOWED_CRAWL_DOMAINS=["kalp-shop.in"]

# ── Security recommendation: if the API requires a key for chat writes, set
#    the key here and pass it via the X-API-Key header from the frontend.
# API_KEY=change-me-too
