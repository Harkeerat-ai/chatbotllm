# ─────────────────────────────────────────────────────────────────────────────
# chatbotllm — environment template
#
# Copy to .env and fill in. Two "moving parts" run AI:
#   1. ANSWERING model  -> OpenRouter (primary) or Groq (legacy fallback)
#   2. EMBEDDING model  -> local sentence-transformers (default), HF cloud, or Ollama
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PATH=./vector_db

# ── Answering model — OpenRouter (primary) ───────────────────────────────────
# The client uses OPENROUTER_* when OPENROUTER_API_KEY is set, and sends the
# HTTP-Referer / X-Title headers OpenRouter expects.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://kalp-shop.in
OPENROUTER_APP_NAME=KALP Chatbot
# Preferred providers, in order — pinned to low-TTFT backends. JSON array.
OPENROUTER_PROVIDERS=["fireworks","together"]

# ── Answering model — Groq (legacy fallback, used only if OPENROUTER_API_KEY empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Embedding model — choose ONE ─────────────────────────────────────────────
#
# Option A (default) — local sentence-transformers, in-process, no API key.
#   First startup downloads ~90 MB of weights. Set HF_HOME to a persistent
#   path so a container restart does not re-download them.
USE_LOCAL_EMBEDDINGS=true
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# Option B — HuggingFace cloud (adds a network round trip per query):
#   USE_LOCAL_EMBEDDINGS=false + HF_API_TOKEN=hf_...
HF_API_TOKEN=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# Option C — local Ollama daemon:
USE_OLLAMA_EMBEDDINGS=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=1024

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now          # change before deploying
SESSION_SECRET=replace-with-a-long-random-string
CSRF_SECRET=replace-with-a-different-long-random-string

# ── CORS — must include every origin that will load the widget ───────────────
# Brands: kalp (kalp-shop.in), vitnrich (vitnrich.com, Shopify),
#         pranada (pranadabiopharma.com, WordPress)
# CORS is GLOBAL (not per-brand), so all widget origins must be listed here.
CORS_ORIGINS=["https://kalp-shop.in","https://chat.kalp-shop.in","https://vitnrich.com","https://pranadabiopharma.com"]

# ── Ingestion tuning ──────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DEFAULT_TOP_K=10

# ── Crawler ───────────────────────────────────────────────────────────────────
CRAWLER_MAX_PAGES=50
CRAWLER_TIMEOUT=10
