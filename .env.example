# ─────────────────────────────────────────────────────────────────────────────
# chatbotllm — environment template
#
# Copy to .env and fill in. Two "moving parts" run AI:
#   1. ANSWERING model  -> any OpenAI-compatible provider (Groq / OpenRouter / ...)
#   2. EMBEDDING model  -> HuggingFace cloud OR local Ollama
#
# The env var names historically say "GROQ_" but the LLM client speaks the
# standard OpenAI format (POST /chat/completions + Bearer + SSE). Point
# GROQ_BASE_URL / GROQ_API_KEY / GROQ_MODEL at whichever provider you use.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PATH=./vector_db

# ── Answering model — OpenAI-compatible provider (choose ONE) ───────────────
#
# Option A — GROQ (free tier, fast LPU, hosts Llama 3.3 70B):
#   GROQ_API_KEY=gsk_...
#   GROQ_MODEL=llama-3.3-70b-versatile
#   GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# Option B — OPENROUTER (one key, many models incl. meta-llama/llama-3.3-70b-instruct):
#   GROQ_API_KEY=sk-or-v1-...
#   GROQ_MODEL=meta-llama/llama-3.3-70b-instruct
#   GROQ_BASE_URL=https://openrouter.ai/api/v1
#
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Embedding model — choose ONE ─────────────────────────────────────────────
#
# Option A — HuggingFace cloud (recommended for PaaS/VPS, no local daemon):
#   HF_API_TOKEN=hf_...                 # read token: huggingface.co/settings/tokens
#   HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
#   USE_OLLAMA_EMBEDDINGS=false
#
# Option B — Local Ollama:
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_EMBED_MODEL=nomic-embed-text
#   USE_OLLAMA_EMBEDDINGS=true
#
HF_API_TOKEN=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_OLLAMA_EMBEDDINGS=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=1024

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now          # change before deploying
SESSION_SECRET=replace-with-a-long-random-string
CSRF_SECRET=replace-with-a-different-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────────
# Add your site origins (e.g. https://kalp-shop.in, https://chat.kalp-shop.in)
CORS_ORIGINS=["http://localhost:8000"]

# ── Ingestion tuning ──────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DEFAULT_TOP_K=10

# ── Crawler ───────────────────────────────────────────────────────────────────
CRAWLER_MAX_PAGES=50
CRAWLER_TIMEOUT=10
